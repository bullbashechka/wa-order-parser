# Все относительные пути считаются от папки app/.

# приём и журнал
TIMEZONE=Asia/Almaty
CSV_DELIMITER=;
OUTPUT_DIR=data/days
PROCESSED_MESSAGES_PATH=data/processed-messages.json

# справочник клиентов
CLIENTS_PATH=clients.json

# генерация документов
GENERATE_TIME=06:00
COMPANY_NAME=Моя организация
INVOICE_CURRENCY=KZT
DEFAULT_UNIT=упак

# Сессия WhatsApp. По умолчанию используется .wwebjs_auth в корне репозитория,
# поэтому после переноса в app/ повторное сканирование QR не требуется.
# WWEBJS_AUTH_PATH=../.wwebjs_auth
